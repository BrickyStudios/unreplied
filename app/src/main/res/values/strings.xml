    <!-- access + onboarding -->
    <string name="access_title">Allow notification access</string>
    <string name="access_body">This is the only way Unreplied sees when you opened a chat. It reads only the messengers you switch on, and nothing leaves the phone.</string>
    <string name="access_button">Allow access</string>
    <string name="restricted_help">Switch greyed out, or Android says “Restricted setting”? Android blocks this for apps installed from a file. Open app info, tap ⋮ at the top right, choose “Allow restricted settings”, then try again.</string>
    <string name="restricted_button">Open app info</string>
    <string name="onboard_title">How it works</string>
    <string name="onboard_1">1. Read your messages as usual.</string>
    <string name="onboard_2">2. Opened a chat but didn’t answer? It lands here.</string>
    <string name="onboard_3">3. Reply, swipe it away, or push it to later. One reminder a day, never one per message.</string>
    <string name="onboard_ok">Got it</string>

