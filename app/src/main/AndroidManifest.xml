<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission on purpose: chat names and previews cannot leave the phone. -->
    <!-- The daily reminder ("4 Leute warten auf dich"). Asked for on first start, Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Tapping a chat opens the messenger, and the settings list the installed ones; Android 11+ only shows apps named here. Keep in sync with MESSENGERS. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <package android:name="org.thoughtcrime.securesms" />
        <package android:name="im.molly.app" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="org.thunderdog.challegram" />
        <package android:name="ch.threema.app" />
        <package android:name="ch.threema.app.libre" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="org.fossify.messages" />
        <package android:name="com.moez.QKSMS" />
        <package android:name="com.instagram.android" />
        <package android:name="com.discord" />
        <package android:name="com.snapchat.android" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unreplied">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads notifications to see when a chat was opened. Only the messengers switched on in the settings are looked at. -->
        <service
            android:name=".RadarListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver android:name=".SummaryReceiver" android:exported="false" />

        <receiver android:name=".RadarWidget" android:exported="false" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>

        <service
            android:name=".RadarTile"
            android:exported="true"
            android:icon="@drawable/ic_stat"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
